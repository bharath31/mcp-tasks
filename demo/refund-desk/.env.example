# Refund Desk (customer application). Holds NO Task Authority database credentials.
REFUND_DESK_DATABASE_URL=postgres://refund_desk:<password>@<host>:5432/refund_desk
PUBLIC_URL=https://refund-desk.example
PORT=8787

# MCP entry authentication (Auth0 for MCP via @auth0/auth0-api-js)
AUTH0_DOMAIN=<tenant>.us.auth0.com
MCP_AUDIENCE=https://refund-desk.example/mcp
# Confidential client used for on-behalf-of exchange to the Task Authority audience
MCP_RESOURCE_CLIENT_ID=<client id>
MCP_RESOURCE_CLIENT_SECRET=<secret>
# {"<verified client id>":"agent_returns"}: unmapped clients are refused
AGENT_BY_CLIENT_JSON={"<mcp-client-id>":"agent_returns"}

# Task Authority service and the three least-privilege M2M roles
TASK_AUTHORITY_URL=https://task-authority.example
TASK_AUTHORITY_AUDIENCE=https://task-authority.example/api
AUTHORITY_API_CLIENT_ID=<delegations:create, operations:register, approvals:request, ...>
AUTHORITY_API_CLIENT_SECRET=
AUTHORITY_EXECUTOR_CLIENT_ID=<claims:create, outcomes:report>
AUTHORITY_EXECUTOR_CLIENT_SECRET=
AUTHORITY_AUDITOR_CLIENT_ID=<audit:read>
AUTHORITY_AUDITOR_CLIENT_SECRET=

# Reviewer page (SPA client; the reviewer's token goes straight to Task Authority)
REVIEWER_CLIENT_ID=<spa client id>

# Provider: "simulator" (default, labelled) or "stripe-test" (sk_test_/rk_test_ only; live keys are refused)
PAYMENTS_MODE=simulator
STRIPE_SECRET_KEY=

# Explicit verified native/UI clients that may call directly without an agent delegation
HUMAN_CLIENT_IDS_JSON=[]
REFUND_CLI_CLIENT_ID=
REFUND_ORGANIZATION_ID=
# Token is optional when using the CLI --login device flow
REFUND_ACCESS_TOKEN=

# How the owner approves their own agent's refund when policy allows it: "elicitation" (default)
# asks in the MCP client; "status" only puts the link in the task's statusMessage, for headless
# hosts that cancel tasks asking for input (claude -p, Agent SDK, GitHub Actions)
OWNER_APPROVAL_PROMPT=elicitation

# Optional confidential reviewer backend (requires Auth0 Enterprise + HRI and registered RAR type)
REVIEWER_PAR_ENABLED=0
REVIEWER_BACKEND_CLIENT_ID=
REVIEWER_BACKEND_CLIENT_SECRET=
# Callback: <PUBLIC_URL>/api/reviewer/callback; backend client must be an allowed human reviewer client

# Optional signed test-mode Stripe reconciliation ingress; API M2M role needs provider-events:write
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_ORGANIZATION_ID=

# Synthetic warehouse producer shared secret
WAREHOUSE_SIGNING_SECRET=<random 32+ chars>

# Nonproduction only: mounts /operator/* scenario controls
DEMO_MODE=0
OPERATOR_TOKEN=
WORKER_INTERVAL_MS=5000
