{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "nominee-shopping-live",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "routes": [{ "pattern": "preview.nominee.dev", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "CUSTOMER_STATE", "class_name": "CustomerHostState" },
      { "name": "MERCHANT_LEDGER", "class_name": "CustomerMerchantLedger" },
      { "name": "AGENT_RUNS", "class_name": "ShoppingAgentRunState" },
    ],
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CustomerHostState", "CustomerMerchantLedger"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ShoppingAgentRunState"],
    },
  ],
  "vars": {
    "SHOPPING_BROWSER_AGENT_ID": "browser-shopping",
    "SHOPPING_MERCHANT_SHIPPING_ADDRESS_ID": "merchant-default",
    "SHOPPING_MERCHANT_DISPLAY_NAME": "Stillroom",
    "SHOPPING_MERCHANT_WALLET_MODE": "simulated",
    "SHOPPING_MERCHANT_WALLET_LABEL": "Stillroom wallet",
  },
}
