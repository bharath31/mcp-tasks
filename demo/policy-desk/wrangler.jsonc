{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mcp-tasks-policy-desk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-09",
  // Live at the custom domain; replaces the Northstar Worker (mcp-tasks-dogfood-demo) on this hostname.
  "routes": [{ "pattern": "mcp-tasks.bharath.sh", "custom_domain": true }],
  "compatibility_flags": ["nodejs_compat"],
  // Run next to the Supabase database (ap-northeast-1, Tokyo), not next to the visitor. A
  // request makes 5 to 100 sequential Postgres round trips; at the edge each one crossed an
  // ocean (about 1.4 s for one trivial MCP tool call), placed here each takes 1 to 3 ms.
  // Static assets are still served from the visitor's nearest data center.
  "placement": { "region": "aws:ap-northeast-1" },
  "workers_dev": false,
  "preview_urls": false,
  // Deliberately NO routes / custom domain: the deployer attaches their own.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/sandbox/*",
      "/v1/*",
      "/healthz",
      "/mcp",
      "/approve",
      "/approve/*",
      "/.well-known/*",
    ],
  },
  // auth0/service/src/store.ts resolves its migrations folder from import.meta.url at
  // module load; workerd has no file URL, so give the bundle a constant (never read).
  "define": { "import.meta.url": "\"file:///policy-desk/src/\"" },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  // Workers AI: the refund agent's model (AGENT_MODEL below). No API key; billed per neuron.
  "ai": { "binding": "AI" },
  // Sandboxes live 15 minutes, so sweep every 5.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Edge per-IP limit on /sandbox/* and /v1/*, checked before the Postgres limiter.
  "ratelimits": [
    {
      "name": "EDGE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  // No Hyperdrive binding: the Worker connects with the DATABASE_URL secret (src/db.ts falls back
  // to it). Add a "hyperdrive" block with a real config id to use Hyperdrive instead.
  // Public values only. Secrets are listed in README.md and set with `wrangler secret put`.
  "vars": {
    // The runtime role cannot run DDL; migrations run out of band (tools/migrate.ts).
    "MIGRATE_ON_REQUEST": "false",
    "AUTH0_DOMAIN": "bharath-okta.us.auth0.com",
    "TASK_AUTHORITY_AUDIENCE": "https://mcp-tasks.bharath.sh/task-authority",
    "SPA_CLIENT_ID": "SWWlishqOFYa6WBEArV84p5rQgUxbEyG",
    "AUTH0_ORG_ID": "org_WherKsfWoCFrlyAT",
    "AGENT_ID": "agent_returns",
    "AGENT_MODEL": "@cf/zai-org/glm-4.7-flash",
    "HIGH_VALUE_QUORUM": "1",
    "FGA_API_URL": "https://api.us1.fga.dev",
    "FGA_STORE_ID": "01M56J1AGS7SJ4RMQP9VKAWXQE",
    "FGA_MODEL_ID": "01M56J50SFH2MHMV5Y9KXCG6ZX",
    "FGA_TOKEN_URL": "https://auth.fga.dev/oauth/token",
    "FGA_TOKEN_AUDIENCE": "https://api.us1.fga.dev/",
  },
}
