# This repo's custom Task Authority approval backend, not an Auth0-hosted service.
# Its own datastore. The customer application must never receive these credentials.
TASK_AUTHORITY_DATABASE_URL=postgres://task_authority_svc:<password>@<host>:5432/task_authority
MIGRATE_ON_START=0

# Identity: tokens are verified against this issuer's JWKS. Single-tenant settings below;
# use TENANTS_JSON (documented below) for multiple issuers.
TENANT_ID=tnt_example
AUTH0_ISSUER=https://<tenant>.us.auth0.com/
AUTH0_AUDIENCE=https://task-authority.example/api

# FGA (OpenFGA HTTP API). Preshared key or a token for Auth0 FGA.
FGA_API_URL=https://api.us1.fga.dev
FGA_STORE_ID=<store id>
FGA_MODEL_ID=<authorization model id>
FGA_API_TOKEN=<token>

# Operator floor: FGA relations and optional hard approval ceiling.
# Publish versioned business approval policy with task-authority policy apply before use.
TENANT_ACTIONS_JSON={"refund:create":{"requesterRelation":"refund_request","approverRelation":"refund_approve","autoApproveCeilings":{"amountMinor":10000},"policyVersion":"refund-policy-v1","resourceServers":["https://api.example/refunds"]}}
# resourceServers: policy keys a human-direct registration may target (empty = none permitted). Human tokens also need the operations:register scope or permission.

# Optional: several tenants in one process instead of the variables above. A JSON array of
# {tenantId, issuer, audience, fga:{apiUrl,storeId,modelId,token}, actions, quotas, claimNamespace, ciba}.
# Each tenant needs a distinct issuer; tokens are routed to a tenant by their verified issuer.
# TENANTS_JSON=

# Optional: explicit CIBA escalation only (poll mode, RAR). Verified only against a local test provider.
# CIBA_BC_AUTHORIZE_URL=https://<tenant>/bc-authorize
# CIBA_TOKEN_URL=https://<tenant>/oauth/token
# CIBA_CLIENT_ID=
# CIBA_CLIENT_SECRET=

# Browser origins allowed to call the decision/read endpoints (the reviewer page). Comma separated.
ALLOWED_ORIGINS=https://refund-desk.example
PORT=8788
HOST=0.0.0.0
